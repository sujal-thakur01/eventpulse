scalar Time
scalar Int64

type CustomerBalance {
  customerId: ID!
  balance: Int64!
  updatedAt: Time!
}

type Transaction {
  id: ID!
  idempotencyKey: String!
  customerId: ID!
  eventType: String!
  amountCents: Int64!
  points: Int64!
  occurredAt: Time!
  createdAt: Time!
}

type TransactionEdge {
  cursor: String!
  node: Transaction!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type TransactionConnection {
  edges: [TransactionEdge!]!
  pageInfo: PageInfo!
}

type Query {
  customerBalance(customerId: ID!): CustomerBalance
  # first is capped at 100 server-side.
  transactionHistory(customerId: ID!, first: Int, after: String): TransactionConnection!
}
